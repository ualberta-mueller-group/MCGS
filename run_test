#!/bin/bash

set -e
#set -x
sudo renice -n -19 -p $$

################################################################################
build_mcgs() {
    cmake --build build -j11
}

make_db() {
    DB_NAME="$1"".bin"
    DB_ARGS="$2"
    ./MCGS --db-file-create "$DB_NAME" "$DB_ARGS"
}

run_test() {
    CSV_NAME="$1"".csv"
    shift
    ./MCGS --run-tests --test-timeout 0 --test-dir cgt_tests/clobber_1xn --out-file "$CSV_NAME" $@
}

compare2() {
    FILE1="$1"".csv"
    FILE2="$2"".csv"
    FILE_OUT="$1""-""$2"".html"
    python3 create-table.py "$FILE1" --compare-to "$FILE2" -o "$FILE_OUT"
}

compare1() {
    FILE1="$1"".csv"
    FILE_OUT="$1"".html"
    python3 create-table.py "$FILE1" -o "$FILE_OUT"
}

################################################################################
rm -f *.csv *.html *.bin
build_mcgs
make_db clobber_1xn_11 '[clobber_1xn] max_dims=11;'
run_test flat_hash --db-file-load clobber_1xn_11.bin

