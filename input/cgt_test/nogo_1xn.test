{version 1.7}
[nogo_1xn]


/* 1 empty */
.

    cgt:
-{|}
    :cgt

    {B loss, W loss}


/* 2 empties */
..

    cgt:
-{| || |}
    :cgt

    {B loss, W loss}


/* 3 empties */
...

    cgt:
-{1 | -1}
    :cgt

    {B loss, W loss}


/* 4 empties */
....

    cgt:
-0
    :cgt

    {B loss, W loss}


/* 5 empties */
.....

    cgt:
-*
    :cgt

    {B loss, W loss}


/* 6 empties */
......

    cgt:
-{1 | -1}
    :cgt

    {B loss, W loss}


/* 7 empties */
.......

    cgt:
-{1* | -(1*)}
    :cgt

    {B loss, W loss}


/* 8 empties */
........

    cgt:
-*
    :cgt

    {B loss, W loss}


/* 9 empties */
.........

    cgt:
-{{2*|0,{1|-1}},{2|1||1*|*}|-({2*|0,{1|-1}}),-({2|1||1*|*})}
    :cgt

    {B loss, W loss}


/* 10 empties */
..........

    cgt:
{1* | -(1*)}
    :cgt

    {B loss, W loss}
