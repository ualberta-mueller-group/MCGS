{version 1.7}
/*_
    i32 max: 2147483647

    i32 min: -2147483648
    MCGS i32 min: -2147483647 (negate_is_safe enforced by constructors etc)
*/

[integer_game]


/* i32 max == 0 layer game */
2147483647

cgt:
    -2147483647
:cgt

{B loss, W loss}


/* i32 max == 1 layer game */
2147483647

cgt:
    -{2147483646|}
:cgt

{B loss, W loss}


/* i32 max == 1 layer game (with applied unary minus) */
2147483647

cgt:
    {|-2147483646}
:cgt

{B loss, W loss}


/* i32 min == 0 layer game */
-2147483647

cgt:
    -(-2147483647)
:cgt

{B loss, W loss}


/* i32 min == 1 layer game */
-2147483647

cgt:
    -{|-2147483646}
:cgt

{B loss, W loss}


/* i32 min == 1 layer game (with applied unary minus) */
-2147483647

cgt:
    {2147483646|}
:cgt

{B loss, W loss}


/* Overflow test: i32 max + 7 */
2147483647
7

cgt:
    -({2147483646|} + {{{{{{{{|}|}|}|}|}|}|}|})
:cgt

{B loss, W loss}


/* Overflow test: i32 max (x2) + 5 */
2147483647
2147483647
5

cgt:
    -({2147483646|} + {2147483646|} + {{{{{{|}|}|}|}|}|})
:cgt

/* Underflow test: i32 min - 7 */
-2147483647
-7

cgt:
    -({|-2147483646} + {|{|{|{|{|{|{|{|}}}}}}}})
:cgt

{B loss, W loss}


